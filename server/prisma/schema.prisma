// Wedison Admin — skema database (PostgreSQL, Prisma 7).
// Modul: Auth/Users, CMS (Article, Category, Tag, PressCoverage, SocialPost, Media),
// SuperCharge (Station), Pricing (PriceRegion, PricingScheme, PriceEntry, PricingTerms), ActivityLog, Setting.
// Konvensi: id = cuid, soft delete via deletedAt hanya di Article (konten editorial).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Auth & Users ─────────────────────────

// Role kustom: kumpulan izin (permission key) yang bisa dibuat/diubah dari admin.
// Katalog izin ada di server/src/lib/permissions.ts. Role `super_admin` (isSystem) selalu
// punya izin "*" dan tidak bisa diubah/dihapus.
model Role {
  id          String   @id @default(cuid())
  key         String   @unique // slug tetap (tidak bisa diubah setelah dibuat)
  name        String   @unique
  description String?
  color       String? // token warna badge (mis. "emerald")
  permissions String[] @default([])
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]

  /// Admin yang membuat / terakhir mengubah (User.id; null = sistem, situs publik, atau sebelum pencatatan)
  createdById String?
  updatedById String?

  @@index([isSystem])
  @@index([createdById])
  @@index([updatedById])
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  /// Wajib untuk user aktif (dijaga aplikasi). Null hanya untuk user terhapus yang role-nya sudah dihapus.
  roleId       String?
  role         Role?     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  isActive     Boolean   @default(true)
  avatarUrl    String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  articles     Article[]
  media        Media[]
  activityLogs ActivityLog[]
  jobsCreated  Job[]         @relation("JobCreatedBy")
  jobsUpdated  Job[]         @relation("JobUpdatedBy")

  /// Admin yang membuat / terakhir mengubah (User.id; null = sistem, situs publik, atau sebelum pencatatan)
  createdById String?
  updatedById String?
  /// Soft delete: user tidak bisa login dan tidak tampil di daftar, tapi jejaknya tetap
  deletedAt   DateTime?
  deletedById String?

  @@index([roleId])
  @@index([createdById])
  @@index([updatedById])
  @@index([deletedAt])
}

// ───────────────────────── CMS: Artikel ─────────────────────────

enum ContentStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum Locale {
  id
  en
}

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  nameId      String
  nameEn      String?
  description String?
  color       String? // token/hex opsional untuk badge
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  articles Article[]

  /// Admin yang membuat / terakhir mengubah (User.id; null = sistem, situs publik, atau sebelum pencatatan)
  createdById String?
  updatedById String?

  @@index([createdById])
  @@index([updatedById])
}

model Tag {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())

  articles Article[]

  updatedAt   DateTime @updatedAt
  /// Admin yang membuat / terakhir mengubah (User.id; null = sistem, situs publik, atau sebelum pencatatan)
  createdById String?
  updatedById String?

  @@index([createdById])
  @@index([updatedById])
}

model Article {
  id           String               @id @default(cuid())
  status       ContentStatus        @default(DRAFT)
  isFeatured   Boolean              @default(false)
  publishedAt  DateTime?
  scheduledAt  DateTime?
  viewCount    Int                  @default(0)
  coverImageId String?
  coverImage   Media?               @relation("ArticleCover", fields: [coverImageId], references: [id], onDelete: SetNull)
  /// Gambar khusus untuk Open Graph/Twitter card (opsional; default = cover)
  ogImageId    String?
  ogImage      Media?               @relation("ArticleOgImage", fields: [ogImageId], references: [id], onDelete: SetNull)
  /// SEO: true = <meta name="robots" content="noindex">
  noIndex      Boolean              @default(false)
  categoryId   String?
  category     Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  authorId     String?
  author       User?                @relation(fields: [authorId], references: [id], onDelete: SetNull)
  tags         Tag[]
  translations ArticleTranslation[]
  deletedAt    DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  /// Admin yang membuat / terakhir mengubah (User.id; null = sistem, situs publik, atau sebelum pencatatan)
  createdById String?
  updatedById String?

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([deletedAt])
  @@index([createdById])
  @@index([updatedById])
}

model ArticleTranslation {
  id             String   @id @default(cuid())
  articleId      String
  article        Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  locale         Locale
  title          String
  slug           String
  excerpt        String?
  content        Json // dokumen Tiptap (ProseMirror JSON) — sumber kebenaran editor
  contentHtml    String   @default("") // HTML tersanitasi, dipakai render publik
  seoTitle       String?
  seoDescription String?
  seoKeywords    String? // dipisah koma
  canonicalUrl   String? // override canonical (mis. artikel repost)
  ogTitle        String?
  ogDescription  String?
  readingTime    Int      @default(1) // menit
  /// Hasil analisis SEO/AEO/GEO terakhir (lib/content-score.ts), dihitung saat simpan
  contentScore   Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([articleId, locale])
  @@unique([locale, slug])
}

// ───────────────────────── CMS: Liputan Pers (berita eksternal) ─────────────────────────

model PressCoverage {
  id          String        @id @default(cuid())
  slug        String        @unique
  url         String        @unique
  title       String
  excerpt     String? // headline/kutipan yang ditampilkan di halaman detail
  description String? // og:description hasil scrape
  imageUrl    String?
  siteName    String?
  author      String?
  publishedAt DateTime?
  status      ContentStatus @default(PUBLISHED)
  sortOrder   Int           @default(0)
  fetchedAt   DateTime? // kapan metadata terakhir di-scrape
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  /// Admin yang membuat / terakhir mengubah (User.id; null = sistem, situs publik, atau sebelum pencatatan)
  createdById String?
  updatedById String?

  @@index([status, publishedAt])
  @@index([createdById])
  @@index([updatedById])
}

// ───────────────────────── CMS: Sosial Media ─────────────────────────

enum SocialPlatform {
  INSTAGRAM
  TIKTOK
  YOUTUBE
  X
  FACEBOOK
  LINKEDIN
}

model SocialPost {
  id           String         @id @default(cuid())
  platform     SocialPlatform @default(INSTAGRAM)
  url          String         @unique
  externalId   String? // shortcode/ID post di platform
  caption      String?
  thumbnailUrl String? // URL lokal hasil unduh (CDN IG kedaluwarsa)
  isActive     Boolean        @default(true)
  sortOrder    Int            @default(0)
  publishedAt  DateTime?
  fetchedAt    DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  /// Admin yang membuat / terakhir mengubah (User.id; null = sistem, situs publik, atau sebelum pencatatan)
  createdById String?
  updatedById String?

  @@index([platform, isActive, sortOrder])
  @@index([createdById])
  @@index([updatedById])
}

// ───────────────────────── CMS: Media Library ─────────────────────────

model Media {
  id           String   @id @default(cuid())
  filename     String   @unique // nama file di disk
  originalName String
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  url          String // path publik, mis. /api/uploads/2026/09/abc.webp
  alt          String?
  caption      String?
  folder       String   @default("general")
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  articlesAsCover Article[] @relation("ArticleCover")
  articlesAsOg    Article[] @relation("ArticleOgImage")

  updatedAt   DateTime @updatedAt
  /// Admin yang membuat / terakhir mengubah (User.id; null = sistem, situs publik, atau sebelum pencatatan)
  createdById String?
  updatedById String?

  @@index([folder, createdAt])
  @@index([createdById])
  @@index([updatedById])
}

// ───────────────────────── SuperCharge: Lokasi ─────────────────────────

enum StationStatus {
  OPERATIONAL
  COMING_SOON
  MAINTENANCE
  CLOSED
}

enum StationTier {
  HUB
  SHOWROOM
  MITRA
}

model Station {
  id         String        @id // kode stasiun, mis. ST0045
  slug       String        @unique
  name       String
  status     StationStatus @default(COMING_SOON)
  tier       StationTier   @default(MITRA)
  address    String
  city       String
  province   String
  lat        Float
  lng        Float
  pilesTotal Int           @default(1) // 1 pile = 2 charger
  powerKw    Int           @default(40)
  hours      String        @default("24 jam")
  amenities  String[]      @default([])
  photoUrl   String?
  notes      String?
  isActive   Boolean       @default(true)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  /// Admin yang membuat / terakhir mengubah (User.id; null = sistem, situs publik, atau sebelum pencatatan)
  createdById String?
  updatedById String?

  @@index([status, tier])
  @@index([province, city])
  @@index([createdById])
  @@index([updatedById])
}

// ───────────────────────── Harga & Skema (Pricing) ─────────────────────────
// Satu sumber kebenaran harga publik: wilayah × skema × model × varian. Dikelola dari
// /admin/pricing, dikonsumsi halaman produk, landing, BaaS, ojol, dan JSON-LD Offer.

enum ProductModel {
  BEES
  ATHENA
  VICTORY
  EDPOWER
}

enum BatteryVariant {
  SINGLE // model satu varian (Bees, EdPower)
  REGULAR
  EXTENDED
}

enum PricingSchemeKind {
  PURCHASE // beli putus: otrPrice, discount, netPrice
  RENT_TO_OWN // dailyFee, downPayment, termMonths; motor jadi milik
  RENTAL // dailyFee, downPayment, termMonths; motor dikembalikan
  B2B_CREDIT // installment24, installment36
  BAAS // unitPrice, monthlyFee
}

enum PricingAudience {
  ALL
  OJOL
  B2B
}

/// Wilayah harga (Jabodetabek, Bali, ...). Wilayah tanpa baris harga tampil sebagai "hubungi sales".
model PriceRegion {
  id            String   @id @default(cuid())
  slug          String   @unique
  nameId        String
  nameEn        String
  priceLabelId  String   @default("") // mis. "Harga OTR Jabodetabek"
  priceLabelEn  String   @default("")
  coverageId    String? // kota yang tercakup
  coverageEn    String?
  salesWhatsapp String? // nomor WA sales wilayah (tanpa +)
  isDefault     Boolean  @default(false)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  prices PriceEntry[]
  terms  PricingTerms[]

  /// Admin yang membuat / terakhir mengubah (User.id; null = sistem, situs publik, atau sebelum pencatatan)
  createdById String?
  updatedById String?

  @@index([isActive, sortOrder])
  @@index([createdById])
  @@index([updatedById])
}

/// Skema pembelian/sewa. `isPublic` = tampil di situs (B2B Bali default tidak).
model PricingScheme {
  id            String            @id @default(cuid())
  slug          String            @unique
  kind          PricingSchemeKind
  nameId        String
  nameEn        String
  taglineId     String?
  taglineEn     String?
  descriptionId String?
  descriptionEn String?
  audience      PricingAudience   @default(ALL)
  isPublic      Boolean           @default(true)
  isActive      Boolean           @default(true)
  sortOrder     Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  prices PriceEntry[]
  terms  PricingTerms[]

  /// Admin yang membuat / terakhir mengubah (User.id; null = sistem, situs publik, atau sebelum pencatatan)
  createdById String?
  updatedById String?

  @@index([isActive, isPublic, sortOrder])
  @@index([createdById])
  @@index([updatedById])
}

/// Satu baris harga. Kolom yang terisi mengikuti `scheme.kind` (sisanya null).
model PriceEntry {
  id       String         @id @default(cuid())
  regionId String
  region   PriceRegion    @relation(fields: [regionId], references: [id], onDelete: Cascade)
  schemeId String
  scheme   PricingScheme  @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  model    ProductModel
  variant  BatteryVariant @default(SINGLE)

  otrPrice      Int? // PURCHASE / B2B_CREDIT (harga OTR sebelum diskon)
  discount      Int? // PURCHASE
  netPrice      Int? // PURCHASE (harga setelah diskon)
  dailyFee      Int? // RENT_TO_OWN / RENTAL
  downPayment   Int? // RENT_TO_OWN / RENTAL
  termMonths    Int? // RENT_TO_OWN / RENTAL
  installment24 Int? // B2B_CREDIT per bulan
  installment36 Int? // B2B_CREDIT per bulan
  unitPrice     Int? // BAAS harga unit tanpa baterai
  monthlyFee    Int? // BAAS langganan baterai per bulan

  noteId    String?
  noteEn    String?
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt

  createdAt   DateTime @default(now())
  /// Admin yang membuat / terakhir mengubah (User.id; null = sistem, situs publik, atau sebelum pencatatan)
  createdById String?
  updatedById String?

  @@unique([regionId, schemeId, model, variant])
  @@index([schemeId, model])
  @@index([createdById])
  @@index([updatedById])
}

/// Bonus per unit, S&K, mitra pembiayaan, dan masa berlaku per wilayah × skema.
model PricingTerms {
  id         String        @id @default(cuid())
  regionId   String
  region     PriceRegion   @relation(fields: [regionId], references: [id], onDelete: Cascade)
  schemeId   String
  scheme     PricingScheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  includedId String[]      @default([]) // "Setiap unit termasuk"
  includedEn String[]      @default([])
  termsId    String[]      @default([]) // Syarat & ketentuan
  termsEn    String[]      @default([])
  partners   String[]      @default([]) // mitra pembiayaan, mis. "Kredivo (personal)"
  validFrom  DateTime?
  validUntil DateTime?
  noteId     String?
  noteEn     String?
  updatedAt  DateTime      @updatedAt

  createdAt   DateTime @default(now())
  /// Admin yang membuat / terakhir mengubah (User.id; null = sistem, situs publik, atau sebelum pencatatan)
  createdById String?
  updatedById String?

  @@unique([regionId, schemeId])
  @@index([createdById])
  @@index([updatedById])
}

// ───────────────────────── Privasi: Persetujuan Cookie ─────────────────────────

enum ConsentAction {
  ACCEPT_ALL
  REJECT_ALL
  CUSTOM
}

/// Bukti persetujuan cookie (akuntabilitas UU PDP). Satu baris per keputusan pengunjung.
/// Tanpa data identitas: consentId = UUID acak dari cookie browser, IP disimpan sebagai hash.
model ConsentLog {
  id        String        @id @default(cuid())
  consentId String // UUID acak di cookie wd_consent (menghubungkan perubahan pilihan pengunjung yang sama)
  version   Int // versi kebijakan cookie yang disetujui
  action    ConsentAction
  analytics Boolean
  marketing Boolean
  locale    String?
  path      String? // halaman tempat keputusan diambil
  ipHash    String? // sha256(salt + IP), bukan IP mentah
  userAgent String?
  createdAt DateTime      @default(now())

  @@index([consentId])
  @@index([createdAt])
}

// ───────────────────────── Sistem ─────────────────────────

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String // create | update | delete | publish | login | ...
  entity    String // article | press | social | media | user | station | ...
  entityId  String?
  summary   String? // ringkasan yang bisa dibaca manusia
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  createdAt   DateTime @default(now())
  /// Admin yang membuat / terakhir mengubah (User.id; null = sistem, situs publik, atau sebelum pencatatan)
  createdById String?
  updatedById String?

  @@index([createdById])
  @@index([updatedById])
}

// ───────────────────────── Leads: Booking showroom & pesan kontak ─────────────────────────

enum BookingPurpose {
  TEST_RIDE
  CONSULTATION
  FINANCING
  SERVICE
  OTHER
}

enum BookingStatus {
  NEW // baru masuk, belum dihubungi
  CONTACTED // sudah dihubungi via WA/telepon
  CONFIRMED // jadwal dikonfirmasi customer
  COMPLETED // kunjungan selesai
  CANCELLED // dibatalkan
  NO_SHOW // tidak datang
}

enum CalendarSyncStatus {
  PENDING
  SAVED
  FAILED
  SKIPPED // Google Calendar belum dikonfigurasi
}

/// Booking Test Ride / kunjungan showroom dari form di situs publik.
model Booking {
  id              String             @id @default(cuid())
  showroom        String // jakarta | bekasi | bandung | bali (registry di modul leads)
  purpose         BookingPurpose
  name            String
  phone           String // dinormalisasi ke 08xxxxxxxxxx
  email           String?
  date            String // YYYY-MM-DD (zona waktu showroom)
  time            String // HH:mm (zona waktu showroom)
  startAt         DateTime // instan UTC dari date+time+zona showroom (untuk sortir/"mendatang")
  note            String?
  source          String? // navbar | nav-sheet | landing-hero | showroom-card | product-hero | product-subnav | showroom-hero | showroom-steps | showroom-cta | contact-page | other
  locale          Locale?
  status          BookingStatus      @default(NEW)
  calendarStatus  CalendarSyncStatus @default(PENDING)
  calendarEventId String?
  calendarLink    String?
  calendarError   String?
  adminNote       String?
  ip              String?
  userAgent       String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  /// Admin yang membuat / terakhir mengubah (User.id; null = sistem, situs publik, atau sebelum pencatatan)
  createdById String?
  updatedById String?

  @@index([startAt])
  @@index([showroom, status])
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([createdById])
  @@index([updatedById])
}

/// Pesan dari form kontak (/[locale]/corporate/contact). Email tetap dikirim via EmailJS.
model ContactSubmission {
  id        String    @id @default(cuid())
  name      String
  email     String
  phone     String
  topic     String
  message   String
  /// Halaman asal form, mis. "contact-page", "surabaya-opening". Null = data lama (halaman Kontak).
  source    String?
  locale    Locale?
  isHandled Boolean   @default(false)
  handledAt DateTime?
  adminNote String?
  ip        String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  /// Admin yang membuat / terakhir mengubah (User.id; null = sistem, situs publik, atau sebelum pencatatan)
  createdById String?
  updatedById String?

  @@index([isHandled, createdAt])
  @@index([createdAt])
  @@index([source, createdAt])
  @@index([createdById])
  @@index([updatedById])
}

// ───────────────────────── HR: Lowongan kerja ─────────────────────────

enum JobStatus {
  DRAFT
  PENDING_REVIEW // diajukan HR_STAFF, menunggu HR_MANAGER
  PUBLISHED
  CLOSED // ditutup manual atau otomatis saat closesAt lewat
  ARCHIVED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
}

enum WorkplaceType {
  ONSITE
  HYBRID
  REMOTE
}

enum ExperienceLevel {
  ENTRY
  JUNIOR
  MID
  SENIOR
  LEAD
  MANAGER
}

model JobDepartment {
  id        String   @id @default(cuid())
  slug      String   @unique
  nameId    String
  nameEn    String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs Job[]

  /// Admin yang membuat / terakhir mengubah (User.id; null = sistem, situs publik, atau sebelum pencatatan)
  createdById String?
  updatedById String?

  @@index([createdById])
  @@index([updatedById])
}

model JobLocation {
  id          String   @id @default(cuid())
  slug        String   @unique
  city        String
  province    String?
  country     String   @default("Indonesia")
  countryCode String   @default("ID") // ISO 3166-1 alpha-2, untuk JSON-LD JobPosting
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobs Job[]

  /// Admin yang membuat / terakhir mengubah (User.id; null = sistem, situs publik, atau sebelum pencatatan)
  createdById String?
  updatedById String?

  @@index([createdById])
  @@index([updatedById])
}

model Job {
  id              String           @id @default(cuid())
  slug            String           @unique
  status          JobStatus        @default(DRAFT)
  departmentId    String?
  department      JobDepartment?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  locations       JobLocation[]
  employmentType  EmploymentType   @default(FULL_TIME)
  workplaceType   WorkplaceType    @default(ONSITE)
  experienceLevel ExperienceLevel?
  openings        Int              @default(1)
  salaryMin       Int?
  salaryMax       Int?
  salaryCurrency  String           @default("IDR")
  showSalary      Boolean          @default(false)
  isUrgent        Boolean          @default(false)
  /// Override penerima lamaran per lowongan (kosong = email lamaran di pengaturan HR)
  applyEmails     String[]         @default([])
  /// Override CC per lowongan (kosong = CC di pengaturan HR)
  ccEmails        String[]         @default([])
  /// Tautan portal lowongan untuk lowongan ini: [{ name, url }]
  portals         Json             @default("[]")
  sortOrder       Int              @default(0)
  publishedAt     DateTime?
  closesAt        DateTime?
  closedAt        DateTime?
  viewCount       Int              @default(0)
  /// Catatan HR_MANAGER saat mengembalikan pengajuan review
  reviewNote      String?
  createdById     String?
  createdBy       User?            @relation("JobCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById     String?
  updatedBy       User?            @relation("JobUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  translations JobTranslation[]
  applyClicks  JobApplyClick[]

  @@index([status, publishedAt])
  @@index([departmentId])
  @@index([closesAt])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([createdById])
  @@index([updatedById])
}

model JobTranslation {
  id               String   @id @default(cuid())
  jobId            String
  job              Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  locale           Locale
  title            String
  summary          String
  responsibilities String[] @default([])
  qualifications   String[] @default([])
  niceToHave       String[] @default([])
  benefits         String[] @default([])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([jobId, locale])
}

/// Klik tombol lamar dari halaman publik (email / nama portal). Untuk metrik minat per lowongan.
model JobApplyClick {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  channel   String // "email" | nama portal (JobStreet, LinkedIn, ...)
  createdAt DateTime @default(now())

  @@index([jobId, createdAt])
}

// ───────────────────────── Showroom teaser (landing pembukaan cabang) ─────────────────────────

enum TeaserStatus {
  DRAFT
  PUBLISHED
  ARCHIVED // halaman publik dialihkan ke /showroom/
}

enum ShowroomStatus {
  OPEN // beroperasi normal
  COMING_SOON // segera dibuka (kartu teaser bila isPublic)
  TEMPORARILY_CLOSED // tutup sementara (tetap tampil, tidak bisa di-booking)
  CLOSED // tutup permanen (tidak tampil di mana pun; riwayat booking tetap)
}

/// Showroom / Experience Center. Satu sumber data untuk form booking (cabang, jam slot, WA),
/// halaman /showroom, halaman Kontak, JSON-LD, llms.txt, Google Calendar, dan Opening Teasers.
model Showroom {
  /// kode tetap, mis. "jakarta" — disimpan di Booking.showroom, jadi tidak bisa diubah
  id              String           @id
  name            String
  /// nama kota pendek ("Bandung") untuk kartu "Segera hadir" dan teks
  city            String
  status          ShowroomStatus   @default(OPEN)
  /// tampil di situs (halaman Showroom, Kontak, JSON-LD). COMING_SOON default tersembunyi.
  isPublic        Boolean          @default(false)
  /// bisa dipilih di form booking (hanya berlaku bila OPEN + isPublic)
  bookable        Boolean          @default(true)
  country         String           @default("ID")
  sortOrder       Int              @default(0)
  streetAddress   String           @default("")
  addressLocality String           @default("")
  addressRegion   String           @default("")
  postalCode      String           @default("")
  lat             Float?
  lng             Float?
  mapsUrl         String?
  /// format internasional tanpa "+", mis. 6285286126550
  whatsapp        String
  phone           String?
  email           String?
  timeZone        String           @default("Asia/Jakarta")
  /// { mon..sun: { open: "HH:MM", close: "HH:MM" } | null, holiday: {...} | null }
  hours           Json
  /// tanggal tutup khusus: [{ from: "YYYY-MM-DD", to: "YYYY-MM-DD", note: string }]
  closures        Json             @default("[]")
  hasWorkshop     Boolean          @default(true)
  hasSupercharge  Boolean          @default(false)
  photoUrl        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  teasers         ShowroomTeaser[]

  /// Admin yang membuat / terakhir mengubah (User.id; null = sistem, situs publik, atau sebelum pencatatan)
  createdById String?
  updatedById String?

  @@index([status, isPublic, sortOrder])
  @@index([createdById])
  @@index([updatedById])
}

/// Landing page teaser pembukaan showroom: /[locale]/showroom/<slug>. Desain tetap di kode;
/// yang diatur admin hanya wording (content), jadwal (timer), gambar, dan titik kontak.
model ShowroomTeaser {
  id              String       @id @default(cuid())
  slug            String       @unique
  city            String
  showroomName    String
  status          TeaserStatus @default(DRAFT)
  /// true = tetap noindex walau sudah tayang (mis. kampanye tertutup)
  noIndex         Boolean      @default(false)
  timeZone        String       @default("Asia/Jakarta")
  startAt         DateTime
  endAt           DateTime
  showCountdown   Boolean      @default(true)
  streetAddress   String       @default("")
  addressLocality String       @default("")
  addressRegion   String       @default("")
  postalCode      String       @default("")
  mapsUrl         String?
  /// nomor WhatsApp format internasional tanpa "+", mis. 6285286126550
  whatsapp        String
  email           String
  /// kunci model yang ditampilkan: athena | bees | victory | edpower (urutan tampil)
  models          String[]     @default([])
  /// { heroDesktop, heroMobile, event, experienceMain, experienceLounge, promo, og } -> URL | null
  images          Json         @default("{}")
  /// { id: TeaserContent, en: TeaserContent } — lihat server/src/modules/teasers/teaser.schema.ts
  content         Json
  /// showroom terkait (opsional): alamat, kontak, zona waktu disalin otomatis dari showroom ini
  showroomId      String?
  showroom        Showroom?    @relation(fields: [showroomId], references: [id], onDelete: SetNull)
  publishedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  /// Admin yang membuat / terakhir mengubah (User.id; null = sistem, situs publik, atau sebelum pencatatan)
  createdById String?
  updatedById String?

  @@index([status, startAt])
  @@index([showroomId])
  @@index([createdById])
  @@index([updatedById])
}
