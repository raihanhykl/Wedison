# ===== Wedison Admin API (Express + Prisma) =====
# Salin ke server/.env lalu isi.

# PostgreSQL lokal (tanpa Docker). Buat DB dulu: createdb wedison_admin
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/wedison_admin?schema=public

# Port API. Next.js me-rewrite /api/* ke sini (lihat next.config.ts).
PORT=4000
HOST=127.0.0.1
NODE_ENV=development

# Secret JWT untuk sesi admin (min. 32 karakter acak): openssl rand -base64 48
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_EXPIRES_IN=7d
COOKIE_NAME=wd_admin_token
# true di produksi (HTTPS di belakang nginx)
COOKIE_SECURE=false

# Origin frontend (untuk CORS saat dev lintas port & webhook revalidate ISR)
FRONTEND_URL=http://localhost:3000
# Harus SAMA dengan REVALIDATE_SECRET di .env.local Next.js
REVALIDATE_SECRET=ganti-dengan-secret-revalidate

# Folder upload media (relatif ke folder server/ atau path absolut)
UPLOAD_DIR=uploads
# URL publik prefix file upload (diserve Express di /api/uploads)
UPLOAD_PUBLIC_PATH=/api/uploads
MAX_UPLOAD_MB=10

# Akun super admin pertama (dipakai prisma seed; ganti password setelah login)
SEED_ADMIN_EMAIL=admin@wedison.co
SEED_ADMIN_PASSWORD=Wedison2026!
SEED_ADMIN_NAME=Super Admin

# Cache in-memory (detik). Ganti ke Redis nanti tanpa mengubah modul (lib/cache.ts).
CACHE_TTL_PUBLIC=300
LOG_LEVEL=info

# ===== Leads: booking form -> Google Calendar (opsional) =====
# Tanpa ini booking tetap tersimpan di DB & tampil di admin, hanya tidak masuk kalender.
# Setup: docs/BOOKING-FORM.md (service account + share kalender "Make changes to events").
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# private_key dari JSON service account, satu baris, newline ditulis sebagai \n
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Alternatif: seluruh JSON service account di-base64 (menggantikan dua variabel di atas)
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
# Calendar ID "Booking Showroom" (Settings > Integrate calendar)
GOOGLE_CALENDAR_ID=2f99738ca12b04fca39d28b3852325e34ad63ecc8b28f0ad697c6ec0b40bc4b0@group.calendar.google.com
# Opsional: kalender terpisah per cabang (fallback ke GOOGLE_CALENDAR_ID)
# GOOGLE_CALENDAR_ID_JAKARTA=
# GOOGLE_CALENDAR_ID_BEKASI=
# GOOGLE_CALENDAR_ID_BANDUNG=
# GOOGLE_CALENDAR_ID_BALI=
# Verifikasi reCAPTCHA v2 di server untuk /public/leads/bookings (secret key, bukan site key)
RECAPTCHA_SECRET_KEY=

# Audit SEO/AEO/GEO situs (admin > SEO & AI Readiness). Default = FRONTEND_URL.
# Di VPS: http://127.0.0.1:3002 (crawl lewat localhost, sitemap otomatis dipetakan ke origin publik).
SITE_AUDIT_URL=
SITE_AUDIT_PUBLIC_ORIGIN=https://wedison.co
