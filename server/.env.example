# ===== Wedison Admin API (Express + Prisma) =====
# Salin ke server/.env lalu isi.

# PostgreSQL lokal (tanpa Docker). Buat DB dulu: createdb wedison_admin
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/wedison_admin?schema=public

# Port API. Next.js me-rewrite /api/* ke sini (lihat next.config.ts).
PORT=4000
HOST=127.0.0.1
NODE_ENV=development

# Secret JWT untuk sesi admin (min. 32 karakter acak): openssl rand -base64 48
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_EXPIRES_IN=7d
COOKIE_NAME=wd_admin_token
# true di produksi (HTTPS di belakang nginx)
COOKIE_SECURE=false

# Origin frontend (untuk CORS saat dev lintas port & webhook revalidate ISR)
FRONTEND_URL=http://localhost:3000
# Harus SAMA dengan REVALIDATE_SECRET di .env.local Next.js
REVALIDATE_SECRET=ganti-dengan-secret-revalidate

# Folder upload media (relatif ke folder server/ atau path absolut)
UPLOAD_DIR=uploads
# URL publik prefix file upload (diserve Express di /api/uploads)
UPLOAD_PUBLIC_PATH=/api/uploads
MAX_UPLOAD_MB=10

# Akun super admin pertama (dipakai prisma seed; ganti password setelah login)
SEED_ADMIN_EMAIL=admin@wedison.co
SEED_ADMIN_PASSWORD=Wedison2026!
SEED_ADMIN_NAME=Super Admin

# Cache in-memory (detik). Ganti ke Redis nanti tanpa mengubah modul (lib/cache.ts).
CACHE_TTL_PUBLIC=300
LOG_LEVEL=info
